# Copy to .env for local development. Use a separate private file for production.
BIOTOOLS_DEBUG=1
BIOTOOLS_URL_FRONT=https://localhost/
BIOTOOLS_SECRET_KEY=local-development-key
BIOTOOLS_ELASTIC_SEARCH_URLS=http://elasticsearch:9200

# The MySQL container and Django use the same database credentials.
BIOTOOLS_MYSQL_ROOT_PASSWORD=elixirroot
BIOTOOLS_MYSQL_DB=elixir
BIOTOOLS_MYSQL_USER=elixir
BIOTOOLS_MYSQL_PASSWORD=123

# Console email is suitable for local development.
BIOTOOLS_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BIOTOOLS_EMAIL_HOST=smtp.zoho.com
BIOTOOLS_EMAIL_PORT=465
BIOTOOLS_EMAIL_USE_SSL=1
BIOTOOLS_EMAIL_USE_TLS=0
BIOTOOLS_EMAIL_HOST_USER=support@bio.tools
BIOTOOLS_EMAIL_HOST_PASSWORD=
BIOTOOLS_DEFAULT_FROM_EMAIL=support@bio.tools

# Use an ORCID sandbox application for local testing.
BIOTOOLS_ORCID_BASE_DOMAIN=sandbox.orcid.org
BIOTOOLS_ORCID_MEMBER_API=0
BIOTOOLS_ORCID_CLIENT_ID=
BIOTOOLS_ORCID_CLIENT_SECRET=
BIOTOOLS_ORCID_CALLBACK_URL=https://localhost/orcid/callback/

# Optional GitHub-to-bio.tools import: enable the github-import Compose profile.
BIOTOOLS_GITHUB_BRIDGE_URL=
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Optional bio.tools-to-GitHub ecosystem export. Use a test repository locally.
BIOTOOLS_GITHUB_ECOSYSTEM_ON=0
ECO_GITHUB_ORGANIZATION_NAME=
ECO_GITHUB_REPO_NAME=
ECO_PERSONAL_TOKEN=
ECO_MASTER_BRANCH=master
ECO_ROOT_GITHUB_FOLDER=data

# Required for production; replace these values for the actual deployment.
BIOTOOLS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
BIOTOOLS_CSRF_TRUSTED_ORIGINS=["https://localhost"]
BIOTOOLS_SESSION_COOKIE_SECURE=1
BIOTOOLS_CSRF_COOKIE_SECURE=1
BIOTOOLS_SECURE_PROXY_SSL_HEADER=["HTTP_X_FORWARDED_PROTO","https"]
